---
layout: layouts/page.njk
title: ""
description: "Milan Shrestha — Technology Professional, Product Builder, and Systems Thinker from Nepal. Building Khaancho, a next-generation classified advertising platform."
---

<section class="hero">
  {% if homePage.profileImage %}
    <img class="hero__avatar" src="{{ homePage.profileImage }}" alt="{{ homePage.profileImageAlt }}" width="160" height="160">
  {% endif %}
  <div class="hero__content">
    <h1>{{ homePage.greeting }}</h1>
    <span class="hero__subtitle">{{ profile.professionalTitle }}</span>
    <p>{{ profile.introduction }}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{ homePage.primaryActionUrl }}">{{ homePage.primaryActionText }}</a>
      <a class="btn btn--secondary" href="{{ homePage.secondaryActionUrl }}">{{ homePage.secondaryActionText }}</a>
    </div>
  </div>
</section>

<section id="working-on">
  <h2>{{ homePage.workingOnHeading }}</h2>
  <ul class="working-on">
    {% for item in homePage.workingOn %}
      <li>{{ item }}</li>
    {% endfor %}
  </ul>
</section>

{% if collections.articles | length > 0 %}
<section id="articles">
  <div class="section-header">
    <h2>{{ homePage.articlesHeading }}</h2>
    <a href="/blog">{{ homePage.articlesViewAllText }}</a>
  </div>
  <div class="cards-grid">
    {% for article in collections.articles | sort(attribute="date", reverse=true) | slice(0, 3) %}
      {% include "components/article-card.njk" %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if collections.projects | length > 0 %}
<section id="projects">
  <div class="section-header">
    <h2>{{ homePage.projectsHeading }}</h2>
    <a href="/projects">{{ homePage.projectsViewAllText }}</a>
  </div>
  <div class="cards-grid">
    {% for project in collections.projects | sort(attribute="sortOrder") | slice(0, 3) %}
      {% include "components/project-card.njk" %}
    {% endfor %}
  </div>
</section>
{% endif %}

<section id="summary">
  <div class="section-header">
    <h2>{{ homePage.aboutHeading }}</h2>
    <a href="/about">{{ homePage.aboutViewAllText }}</a>
  </div>
  <p>{{ homePage.aboutText }}</p>
</section>

<section id="contact-cta">
  <h2>Let's Connect</h2>
  <p>Looking to collaborate, share ideas, or build something meaningful together?</p>
  <a class="btn btn--primary" href="/contact">Get in Touch</a>
</section>
