---
layout: layouts/page.njk
title: "About"
description: "Learn more about Milan Shrestha: background, experience, skills, and philosophy."
---

<h1>{{ aboutPage.title }}</h1>
<p class="page-lead">{{ aboutPage.aboutContent }}</p>

<section>
  <h2>{{ aboutPage.philosophyHeading }}</h2>
  <blockquote>{{ aboutPage.philosophy }}</blockquote>
</section>

<section>
  <h2>{{ aboutPage.skillsHeading }}</h2>
  <div class="skills-grid">
    {% for group in aboutPage.skills %}
      <div class="skill-category">
        <h3>{{ group.category }}</h3>
        <ul>
          {% for item in group.items %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}
  </div>
</section>

<section>
  <h2>{{ aboutPage.expertiseHeading }}</h2>
  <p class="page-lead expertise-lead">{{ aboutPage.expertiseSubtitle }}</p>
  <div class="skills-grid">
    {% for group in aboutPage.expertise %}
      <div class="skill-category">
        <h3>{{ group.category }}</h3>
        <div class="expertise-items">
          {% for item in group.items %}
            <div class="expertise-item">
              <span class="expertise-item-title">{{ item.name }}</span>
              <p class="expertise-item-desc">{{ item.description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<section>
  <h2>{{ aboutPage.hotelTechHeading }}</h2>
  <p class="page-lead expertise-lead">{{ aboutPage.hotelTechSubtitle }}</p>
  <div class="skills-grid">
    {% for group in aboutPage.hotelTechnologies %}
      <div class="skill-category">
        <h3>{{ group.category }}</h3>
        <div class="expertise-items">
          {% for item in group.items %}
            <div class="expertise-item">
              <span class="expertise-item-title">{{ item.name }}</span>
              <p class="expertise-item-desc">{{ item.description }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<section>
  <h2>{{ aboutPage.experienceHeading }}</h2>
  <div class="experience-list">
    {% for job in aboutPage.experience | sort(attribute="sortOrder") %}
      <div class="job">
        <div class="job__meta">
          <span class="job__role">{{ job.role }}</span>
          <span class="job__period">
            {% if job.startDate %}
              {{ job.startDate }} — {% if job.isCurrent %}Present{% else %}{{ job.endDate }}{% endif %}
            {% endif %}
          </span>
          {% if job.isCurrent %}<span class="job__current">Current</span>{% endif %}
        </div>
        <h3>{{ job.organization }}</h3>
        {% if job.description %}
          <p>{{ job.description }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% if aboutPage.learning %}
<section>
  <h2>{{ aboutPage.learningHeading }}</h2>
  <div class="learning-grid">
    {% for item in aboutPage.learning %}
      <div class="learning-item">{{ item }}</div>
    {% endfor %}
  </div>
</section>
{% endif %}
