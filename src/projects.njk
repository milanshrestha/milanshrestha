---
layout: layouts/page.njk
title: "{{ projectsPage.title }} — {{ profile.name }}"
description: "Selected projects by {{ profile.name }}: products, case studies, and ongoing work."
---

<h1>{{ projectsPage.title }}</h1>
<p class="page-lead">{{ projectsPage.lead }}</p>

{% if collections.projects | length > 0 %}
  <div class="cards-grid">
    {% for project in collections.projects | sort(attribute="sortOrder") %}
      {% include "components/project-card.njk" %}
    {% endfor %}
  </div>
{% else %}
  <p class="empty-state">No projects published yet. Check back soon.</p>
{% endif %}
