---
layout: layouts/page.njk
title: "{{ title }} — {{ profile.name }}"
description: "{{ seoDescription | default(excerpt) }}"
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    <li><a href="/blog">Blog</a></li>
    <li aria-current="page">{{ title }}</li>
  </ol>
</nav>

<article class="article-single">
  <header class="article-header">
    {% if categories %}
      <span class="article-category">
        {{ categories | join(", ") }}
      </span>
    {% endif %}
    <h1>{{ title }}</h1>
    {% if excerpt %}
      <p class="article-excerpt">{{ excerpt }}</p>
    {% endif %}
    <div class="article-meta">
      {% if publishedAt %}
        <time class="article-date" datetime="{{ publishedAt }}">{{ publishedAt | date }}</time>
      {% endif %}
      <span>&bull;</span>
      {% if profile.name %}
        <span class="article-byline">By {{ profile.name }}</span>
      {% endif %}
      <span>&bull;</span>
      <span class="article-reading-time">{{ content | readingTime }}</span>
    </div>
  </header>

  {% if coverImage %}
    <img class="article-cover" src="{{ coverImage }}" alt="{{ coverImageAlt | default(title) }}" width="800" height="450" loading="lazy">
  {% endif %}

  <div class="article-body">
    {{ content | safe }}
  </div>

  {% if tags | length > 0 %}
    <footer class="article-footer">
      <ul class="tag-list">
        {% for tag in tags %}
          <li>{{ tag }}</li>
        {% endfor %}
      </ul>
    </footer>
  {% endif %}
</article>

{% set nav = collections.articles | prevNextArticles(slug) %}
{% if nav.prev or nav.next %}
<nav class="article-pagination" aria-label="Article navigation">
  {% if nav.prev %}
    <a href="{{ nav.prev.url }}" class="prev">
      <span class="label">&larr; Previous Article</span>
      <span class="title">{{ nav.prev.data.title }}</span>
    </a>
  {% else %}
    <span></span>
  {% endif %}
  {% if nav.next %}
    <a href="{{ nav.next.url }}" class="next">
      <span class="label">Next Article &rarr;</span>
      <span class="title">{{ nav.next.data.title }}</span>
    </a>
  {% else %}
    <span></span>
  {% endif %}
</nav>
{% endif %}

{% set related = collections.articles | relatedArticles({ data: { slug: slug, categories: categories, tags: tags } }) %}
{% if related | length > 0 %}
  <section class="related-articles">
    <h2>Related Articles</h2>
    <div class="cards-grid">
      {% for r in related %}
        {% include "components/article-card.njk" %}
      {% endfor %}
    </div>
  </section>
{% endif %}
