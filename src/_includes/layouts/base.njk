<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description | default(profile.introduction) }}">
    <title>{% if title and title != profile.name %}{{ title }} — {{ profile.name }}{% else %}{{ profile.name }}{% endif %}</title>
    <link rel="stylesheet" href="/styles/tokens.css">
    <link rel="stylesheet" href="/styles/global.css">
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {% include "components/header.njk" %}
    <main id="content">
      {{ content | safe }}
    </main>
    {% include "components/footer.njk" %}

    <!-- Search Modal Overlay -->
    <div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-label="Search">
      <div class="search-modal-backdrop"></div>
      <div class="search-modal-container">
        <div class="search-modal-header">
          <div class="search-input-wrapper">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input
              id="modal-search-input"
              type="search"
              placeholder="Search articles, projects, & topics…"
              autocomplete="off"
              aria-label="Search the site"
            />
          </div>
          <button class="search-modal-close" aria-label="Close search">ESC</button>
        </div>
        <div id="modal-search-results" class="search-modal-results" aria-live="polite">
          <p class="search-hint">Type to start searching across all articles and projects...</p>
        </div>
      </div>
    </div>

    <script>
      window.siteSearchIndex = {
        articles: [
          {% for a in collections.articles %}
            { title: "{{ a.data.title | replace('"', '\\"') }}", url: "{{ a.url }}", excerpt: "{{ a.data.excerpt | default('') | replace('"', '\\"') }}", type: "article" },
          {% endfor %}
        ],
        projects: [
          {% for p in collections.projects %}
            { title: "{{ p.data.title | replace('"', '\\"') }}", url: "{{ p.url }}", excerpt: "{{ p.data.summary | replace('"', '\\"') }}", type: "project" },
          {% endfor %}
        ]
      };
    </script>
    <script src="/styles/scripts.js" defer></script>
  </body>
</html>
