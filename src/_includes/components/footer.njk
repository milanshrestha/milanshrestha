<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-col">
      <div class="footer-brand">Milan Shrestha</div>
      <p class="footer-desc">Technology Professional, Product Builder, and Systems Thinker from Nepal.</p>
    </div>
    
    <div class="footer-col">
      <h3>Navigation</h3>
      <ul class="footer-nav">
        {% for item in navigation %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
