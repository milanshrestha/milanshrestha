<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-col">
      <div class="footer-brand">{{ profile.name }}</div>
      <p class="footer-desc">{{ footerData.description }}</p>
    </div>

    <div class="footer-col">
      <h3>{{ footerData.navigationHeading }}</h3>
      <ul class="footer-nav">
        {% for item in navigation %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-col">
      <h3>{{ footerData.getInTouchHeading }}</h3>
      <ul class="footer-social">
        {% for link in footerData.socialLinks %}
          <li><a href="{{ link.url }}" {% if link.external %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; <span id="year"></span> {{ profile.name }}. All rights reserved.</p>
  </div>
</footer>
