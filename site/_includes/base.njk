<!doctype html>
<html lang="en" data-color-mode="dark" data-dark-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0d1117">
    <meta name="description" content="{{ description }}">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="./primer.css">
    <style>
      :root {
        color-scheme: dark;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: var(--bgColor-default, #0d1117);
        color: var(--fgColor-default, #e6edf3);
        --accent: var(--fgColor-accent, #58a6ff);
        --muted: var(--fgColor-muted, #8b949e);
        --border: var(--borderColor-default, #30363d);
        --surface: var(--bgColor-muted, #161b22);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        padding: 0;
        line-height: 1.6;
      }

      /* Skip link */
      .skip-link {
        position: absolute;
        top: -100%;
        left: 0;
        background: #58a6ff;
        color: #0d1117;
        padding: 0.5rem 1rem;
        z-index: 100;
        transition: top 0.2s;
      }
      .skip-link:focus { top: 0; }

      /* Navigation */
      header {
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid var(--border);
        background: rgba(13, 17, 23, 0.8);
        backdrop-filter: blur(8px);
      }
      .nav-container {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .logo {
        font-weight: 700;
        font-size: 1.125rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .logo span { color: var(--accent); }
      nav ul {
        display: none;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 1.5rem;
      }
      nav ul li a {
        text-decoration: none;
        color: inherit;
        font-size: 0.9375rem;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        transition: background 0.2s;
      }
      nav ul li a:hover { background: var(--surface); }
      .nav-toggle {
        display: flex;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
      }
      .nav-toggle span {
        display: block;
        width: 20px;
        height: 2px;
        background: #e6edf3;
        border-radius: 2px;
        transition: transform 0.2s, opacity 0.2s;
      }

      @media (min-width: 48rem) {
        nav ul { display: flex; }
        .nav-toggle { display: none; }
      }

      /* Main layout */
      main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 3rem 1rem 4rem;
      }

      section { margin-bottom: 4rem; }

      h1, h2, h3 { margin-top: 0; }
      h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.5rem; }
      h2 { font-size: clamp(1.5rem, 4vw, 2rem); margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
      h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }

      p { color: var(--muted); margin: 0 0 1rem; }

      blockquote {
        margin: 0 0 1.5rem;
        padding: 1rem 1.5rem;
        border-left: 4px solid var(--accent);
        background: var(--surface);
        border-radius: 0 0.5rem 0.5rem 0;
        font-style: italic;
        color: #c9d1d9;
      }

      ul { margin: 0 0 1.5rem; padding-left: 1.5rem; }
      li { margin-bottom: 0.375rem; color: var(--muted); }

      /* Hero */
      .hero {
        text-align: center;
        padding: 4rem 0 2rem;
      }
      .hero .avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 4px solid var(--border);
        margin-bottom: 1rem;
        object-fit: cover;
        display: block;
        margin-left: auto;
        margin-right: auto;
        background: var(--surface);
        color: var(--accent);
        font-size: 3rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .hero h1 { margin-bottom: 0.25rem; }
      .hero .subtitle {
        font-size: 1.125rem;
        color: var(--accent);
        margin-bottom: 1rem;
        display: block;
      }
      .hero p { max-width: 42rem; margin: 0 auto 2rem; color: #c9d1d9; }

      /* Working on */
      .working-on {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
      }
      .working-on li {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1rem;
        list-style: none;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
      }
      .working-on li::before { content: "▹"; color: var(--accent); font-weight: bold; flex-shrink: 0; }

      /* Skills */
      .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
      }
      .skill-category {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.5rem;
      }
      .skill-category h3 { border-bottom: none; padding-bottom: 0; margin-bottom: 1rem; color: var(--accent); }
      .skill-category ul { margin: 0; padding-left: 0; list-style: none; }
      .skill-category li {
        font-size: 0.9375rem;
        padding: 0.4rem 0;
        border-bottom: 1px solid rgba(48, 54, 61, 0.3);
      }
      .skill-category li:last-child { border-bottom: none; }

      /* Experience */
      .experience-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      .job {
        border-left: 3px solid var(--accent);
        padding-left: 1.25rem;
      }
      .job h3 { color: #c9d1d9; margin-bottom: 0.125rem; }
      .job .org { color: var(--accent); font-size: 0.9375rem; margin-bottom: 0.25rem; }
      .job .role-time { font-size: 0.875rem; color: var(--muted); margin-bottom: 0.75rem; }
      .job ul { margin: 0; padding-left: 1.25rem; }

      /* Learning */
      .learning-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
      }
      .learning-item {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1rem;
        text-align: center;
        color: #c9d1d9;
        font-size: 0.9375rem;
      }

      /* Projects */
      .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
      }
      .project-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.5rem;
      }
      .project-card h3 { margin-bottom: 0.5rem; color: #c9d1d9; }
      .project-card p { margin-bottom: 1rem; font-size: 0.9375rem; }
      .project-card .focus {
        font-size: 0.875rem;
        color: var(--muted);
        margin-bottom: 1rem;
      }
      .project-card .focus span {
        display: inline-block;
        background: rgba(88, 166, 255, 0.1);
        color: var(--accent);
        padding: 0.2rem 0.6rem;
        border-radius: 1rem;
        margin: 0.125rem;
        font-size: 0.8125rem;
      }
      .project-card .what-i-deliver {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
      }
      .project-card .what-i-deliver h4 {
        font-size: 0.9375rem;
        margin-bottom: 0.5rem;
        color: #c9d1d9;
      }
      .project-card .what-i-deliver ul { margin: 0; padding-left: 1.25rem; font-size: 0.875rem; }

      /* Goals */
      .goals-list { margin: 0; padding-left: 1.5rem; list-style: none; }
      .goals-list li {
        position: relative;
        padding-left: 1.5rem;
        margin-bottom: 0.75rem;
        color: #c9d1d9;
      }
      .goals-list li::before {
        content: "▹";
        position: absolute;
        left: 0;
        color: var(--accent);
        font-weight: bold;
      }

      /* Tech stack */
      .tech-table { width: 100%; border-collapse: separate; border-spacing: 0.5rem; }
      .tech-table td {
        width: 96px;
        height: 96px;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        background: var(--surface);
        text-align: center;
        vertical-align: middle;
        padding: 0.5rem;
      }
      .tech-table td a { text-decoration: none; color: inherit; display: block; }
      .tech-table img { width: 48px; height: 48px; display: block; margin: 0 auto 0.5rem; }
      .tech-table td br + span { display: block; font-size: 0.8125rem; color: var(--muted); }

      /* Connect */
      .connect {
        text-align: center;
        padding: 3rem 0;
      }
      .connect h2 { border: none; padding-bottom: 0; }
      .connect .tech-table { margin-top: 2rem; }

      footer {
        text-align: center;
        padding: 2rem 0;
        color: var(--muted);
        font-size: 0.875rem;
        border-top: 1px solid var(--border);
      }

      @media (max-width: 48rem) {
        .hero img { width: 100px; height: 100px; }
        main { padding: 2rem 1rem 3rem; }
        section { margin-bottom: 3rem; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header>
      <div class="nav-container">
        <a class="logo" href="#home">M<span>.</span></a>
        <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <nav>
          <ul id="nav-list">
            <li><a href="#hero">Home</a></li>
            <li><a href="#working-on">Working On</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#experience">Experience</a></li>
            <li><a href="#learning">Learning</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#goals">Goals</a></li>
            <li><a href="#tech-stack">Tech Stack</a></li>
            <li><a href="#connect">Connect</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="content">
      {{ content | safe }}
    </main>

    <footer>
      &copy; <span id="year"></span> Milan Shrestha. Built with care from Nepal.
    </footer>

    <script>
      // Mobile nav toggle
      const toggle = document.querySelector('.nav-toggle');
      const navList = document.getElementById('nav-list');
      let expanded = false;
      toggle.addEventListener('click', () => {
        expanded = !expanded;
        toggle.setAttribute('aria-expanded', expanded);
        navList.style.display = expanded ? 'flex' : 'none';
        navList.style.flexDirection = 'column';
        navList.style.position = 'absolute';
        navList.style.top = '100%';
        navList.style.left = '0';
        navList.style.right = '0';
        navList.style.background = 'var(--surface)';
        navList.style.borderTop = '1px solid var(--border)';
        navList.style.padding = '1rem';
        navList.style.gap = '0';
      });

      // Close nav on link click
      navList.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          expanded = false;
          toggle.setAttribute('aria-expanded', 'false');
          navList.style.display = 'none';
        });
      });

      // Year in footer
      document.getElementById('year').textContent = new Date().getFullYear();
    </script>
  </body>
</html>
